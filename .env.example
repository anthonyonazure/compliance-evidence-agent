# Inherits from b2b-agent-toolkit (B2B_*)
B2B_USE_MOCKS=true

B2B_M365_TENANT_ID=
B2B_M365_CLIENT_ID=
B2B_M365_CLIENT_SECRET=
B2B_M365_DOMAIN=

# Azure subscription to scan with Resource Graph queries (KV, storage, etc.)
B2B_AZURE_SUBSCRIPTION_ID=

# Anthropic — optional. With the key, the gap-summary section is LLM-generated;
# without it, the agent uses a deterministic stub.
ANTHROPIC_API_KEY=
COMPLIANCE_MODEL=claude-sonnet-4-6

# Where to upload the signed evidence pack
COMPLIANCE_OUT_DIR=evidence-packs
